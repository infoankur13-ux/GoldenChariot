  "motion_and_interactions": {
    "hero_slider": {
      "interval_ms": 4500,
      "transition": "opacity 1.15s cubic-bezier(0.4, 0, 0.2, 1)",
      "pause_on_hover": true
    },
    "scroll_reveal": {
      "implementation": "IntersectionObserver in script.js adding .is-revealed class",
      "styles": "opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease;"
    },
    "button_hover": "transform: translateY(-2px); box-shadow: 0 12px 26px -13px rgba(154,123,56,0.76)",
    "card_hover": "transform: translateY(-7px); border-color: rgba(197,160,89,0.62); box-shadow: 0 22px 48px -28px rgba(28,22,17,0.32)"
  },
  "responsive_breakpoints": {
    "desktop": "1150px and above: 4-column product grid, 5-column quality process steps, sticky topbar + header",
    "tablet": "800px to 1150px: 2-column product grid, hide desktop nav links in favor of mobile drawer",
    "mobile": "below 800px: single column hero layout, 1-column reviews carousel, bottom-sheet style enquiry modal"
  },
