{
  "project_overview": {
    "title": "Golden Chariot Foodstuff Trading Co. LLC - UI/UX Refinement Guidelines",
    "description": "Premium, modern, responsive B2B corporate website polish for Golden Chariot Foodstuff Trading Co. LLC, Dubai. Visual direction: Gold, Warm Cream, and Dark Brown palette.",
    "architecture_stack": "Vanilla HTML5, CSS3, JavaScript/jQuery 3.7. NO React, Next.js, Tailwind, or complex build tools. Static site files located at /app/frontend/public/index.html, /app/frontend/public/style.css, /app/frontend/public/script.js.",
    "primary_objective": "Execute a visual and frontend refinement pass without altering approved content structure or layout architecture. Enhance photography, icons, typography, spacing, transitions, and responsive polish."
  },
  "color_palette": {
    "brand_colors": {
      "--gold": "#c5a059",
      "--gold-rich": "#d4af37",
      "--gold-light": "#e6ca65",
      "--gold-dark": "#9a7b38"
