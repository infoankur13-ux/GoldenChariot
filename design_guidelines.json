    "surface_colors": {
      "--cream": "#faf7f2",
      "--ivory": "#fdfcf7",
      "--ebony": "#1c1611",
      "--coal": "#120e0b",
      "--stone": "#8c827a",
      "--text": "#3a332c",
      "--light-text": "#d8ceb9"
    },
    "decorations": {
      "--line": "rgba(197, 160, 89, 0.25)",
      "--shadow": "0 22px 48px -28px rgba(28, 22, 17, 0.32)",
      "hero_gradient": "linear-gradient(90deg, rgba(253,252,247,0.98) 0%, rgba(250,247,242,0.91) 39%, rgba(250,247,242,0.43) 66%, rgba(28,22,17,0.14) 100%)"
    }
  },
  "typography": {
    "font_families": {
      "display_heading": "'Cormorant Garamond', Georgia, serif",
      "body_text": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "labels_and_mono": "'JetBrains Mono', monospace"
    },
    "type_scale": {
      "h1_hero": "clamp(3.25rem, 6.2vw, 5.55rem), weight: 600, line-height: 1.07",
      "h2_section": "clamp(2.4rem, 5vw, 4.25rem), weight: 600, line-height: 1.07",
      "h3_card": "21px to 25px, weight: 600",
      "eyebrow_label": "10px, weight: 500, letter-spacing: 0.28em, uppercase",
      "body_copy": "15px (1.02rem to 1.03rem), line-height: 1.6"
    }
  },
